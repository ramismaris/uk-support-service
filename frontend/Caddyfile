# Static server of the web container; HTTPS and /api are handled by the edge Caddy in deploy/.
:80 {
	root * /srv

	# Hashed build files never change. Everything else ends up as index.html (SPA routes too),
	# which must be re-read to pick up a new release.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/*
	header @page Cache-Control "no-cache"

	# A missing build file is a 404, not index.html: a tab from before a deploy then gets a clean
	# load error for its old chunk and reloads (see app/entrypoint/stale-build.ts).
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
