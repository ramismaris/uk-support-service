# Необязательные настройки локального запуска (docker-compose.yml в корне).
# Без этого файла всё работает: пустое значение = значение по умолчанию из docker-compose.yml.
# Чтобы задать свои: cp .env.example .env, заполнить, docker compose up -d --wait.
# Сервер настраивается не здесь, а в deploy/.env.

# Порт панели на localhost; по умолчанию 8080.
WEB_PORT=

# Бот Max: BOT_MODE=polling и токен бота. По умолчанию бот выключен.
# Пока бот с этим токеном работает где-то ещё (например, на сервере), локально его не включайте:
# два процесса с одним токеном делят апдейты между собой.
BOT_MODE=
BOT_TOKEN=

# max_user_id первых админов через запятую; свой id бот присылает на команду /id.
ADMIN_MAX_USER_IDS=

# Выводы ИИ на дашборде: OpenAI-совместимый API. Пустые LLM_BASE_URL и LLM_MODEL — выводов нет.
# AI_INSIGHTS_ENABLED=false выключает выводы, даже если ИИ настроен.
AI_INSIGHTS_ENABLED=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# JSON с дополнительными заголовками запроса, например {"x-opencode-session":"uk-support"}.
LLM_EXTRA_HEADERS=
