# Домен сервиса: A-запись должна указывать на сервер, например uk.example.ru
DOMAIN=

# Продакшен: без /docs (DEBUG=false) и без входа в обход Max (DEV_AUTH=false).
# SPA и API на одном домене, поэтому CORS не нужен.
DEBUG=false
DEV_AUTH=false
CORS_ORIGINS=[]

# Бот Max. ADMIN_MAX_USER_IDS — max_user_id первых админов через запятую;
# свой id бот присылает в ответ на /id.
BOT_MODE=polling
BOT_TOKEN=
ADMIN_MAX_USER_IDS=

# Секреты генерируйте командой: openssl rand -hex 32
SECRET_KEY=

# База данных; DATABASE_HOST и DATABASE_PORT задаёт docker compose.
# Пароль — тоже openssl rand -hex 32: DATABASE_PASSWORD подставляется в URL без экранирования,
# поэтому символы /, @, + в нём сломали бы подключение.
DATABASE_USER=uk
DATABASE_PASSWORD=
DATABASE_NAME=uk_support

# Каталог с собранным фронтендом. Меняйте, если сборка кладёт статику не в ../frontend/dist
# SITE_DIR=../frontend/dist
